
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "07641d92b7041b9560535ef971850215",
	"name": "mist",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{ "name": "DocumentAgent", "class_name": "DocumentAgent" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["DocumentAgent"] }
	],
	"keep_vars": true
}
